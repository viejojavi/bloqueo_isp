rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'ticcolcolombia@gmail.com' && isEmailVerified()) ||
        request.auth.uid == 'CYRVOTbehhZoXiyFhERRG6Iyg623'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidISP(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.logo is string && data.logo.size() <= 2097152 &&
             data.ips is list && data.ips.size() <= 500 &&
             data.activationType in ['default', 'indefinite', 'monthly'] &&
             data.status in ['active', 'suspended'];
    }

    function isValidSystemConfig(data) {
      return data.defaultName is string && data.defaultName.size() <= 100 &&
             data.defaultLogo is string && data.defaultLogo.size() <= 2097152 &&
             data.protectedFiles is list;
    }

    // --- Collections ---

    match /isps/{ispId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(ispId) && isValidISP(incoming());
      allow update: if isAdmin() && isValidISP(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }
    
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin() && isValidSystemConfig(incoming());
    }
    
    match /protectedFiles/{fileId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(fileId);
      
      match /lines/{lineId} {
        allow read: if true;
        allow write: if isAdmin() && isValidId(lineId);
      }
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    match /test/connection {
      allow read, write: if true;
    }
  }
}


