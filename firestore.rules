rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ticcolcolombia@gmail.com' ||
        request.auth.uid == 'CYRVOTbehhZoXiyFhERRG6Iyg623'
      );
    }

    // ISP Collection
    match /isps/{ispId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Settings Document
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins List
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Connectivity Test
    match /test/connection {
      allow read, write: if true;
    }
  }
}


